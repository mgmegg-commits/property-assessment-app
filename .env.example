# Settings for this computer's copy of Cecil's Report Builder.
# ./start.sh copies this file to .env the first time, with a new database
# password. .env stays on this computer and is never committed.

# development: a test copy with test data. production: a real copy.
APP_ENV=development

# 1 loads the test organizations (tests/fixtures/seed) the first time the database is empty.
LOAD_FIXTURES=1

# Filled in by ./start.sh the first time.
POSTGRES_PASSWORD=
# The password to sign in with (v1's one login). ./start.sh makes one and prints it.
APP_PASSWORD=
# Signs the sign-in cookie. ./start.sh makes one.
SESSION_SECRET=

# Drafting with Claude (optional): your own Claude API key. Leave empty to draft by hand.
ANTHROPIC_API_KEY=

# Where "today" is, for due dates and overdue flags.
TIME_ZONE=America/Chicago

# Ports on this computer.
# The app on this computer: http://localhost:8080
APP_PORT=8080
# The app for iPads and iPhones on the same Wi-Fi: https://<this computer>.local:8443
HTTPS_PORT=8443
# Certificate set-up page for iPads and iPhones: http://<this computer>.local:8081
SETUP_PORT=8081
