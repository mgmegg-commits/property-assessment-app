# Caddy for a copy running on a Mac or another computer on a home or office
# network. Caddy makes its own certificate authority and certificates
# (local_certs), so iPads and iPhones get HTTPS once they trust it.
# A copy on a server with a real domain name gets its own Caddyfile (Milestone 4).
#
#   :8080  the app over plain HTTP, published on this computer only (127.0.0.1)
#   :8443  the app over HTTPS, at the addresses in SITE_ADDRESSES (set by ./start.sh)
#   :8081  set-up page: the certificate for iPads and iPhones to trust

{
	local_certs
	skip_install_trust
	admin off
	auto_https disable_redirects
	# Devices opening the app by IP address don't say which site they want (no SNI), so give them this one.
	default_sni {$DEFAULT_SNI:localhost}
}

http://:8080 {
	encode zstd gzip
	reverse_proxy app:3000
}

{$SITE_ADDRESSES} {
	encode zstd gzip
	reverse_proxy app:3000
}

http://:8081 {
	header {
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
		Cache-Control no-store
	}

	handle /certificate.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Set up this iPad or iPhone</title>
			<style>
			body { font: 17px/1.5 -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background: #F3F5F6; color: #17212B; }
			main { max-width: 560px; margin: 0 auto; padding: 24px 16px 40px; }
			h1 { font-size: 1.5rem; margin: 0 0 8px; }
			ol { padding-left: 1.3em; }
			li { margin: 0 0 12px; }
			a.button { display: inline-block; background: #1F4B6E; color: #fff; text-decoration: none; padding: 12px 18px; border-radius: 6px; font-weight: 600; }
			.muted { color: #586674; font-size: .9rem; }
			code { overflow-wrap: anywhere; }
			</style>
			</head>
			<body>
			<main>
			<h1>Set up this iPad or iPhone</h1>
			<p>Do this once on each device, so it can open the test copy of Cecil's Report Builder running on this computer.</p>
			<ol>
			<li><a class="button" href="/certificate.crt">Download the certificate</a><br>Tap <b>Allow</b> when asked to download a configuration profile.</li>
			<li>Open <b>Settings</b>, tap <b>Profile Downloaded</b> near the top, then <b>Install</b> and enter your passcode.</li>
			<li>In <b>Settings</b>, go to <b>General › About › Certificate Trust Settings</b> and turn on <b>Caddy Local Authority</b>.</li>
			<li>Open the app: <a href="{$PRIMARY_URL}">{$PRIMARY_URL}</a><br>In Safari, use <b>Share › Add to Home Screen</b> to get an app icon.</li>
			</ol>
			<p class="muted">The certificate only lets this device trust this computer's test copy. Remove it any time in Settings › General › VPN &amp; Device Management.</p>
			</main>
			</body>
			</html>
			HTML 200
	}
}
